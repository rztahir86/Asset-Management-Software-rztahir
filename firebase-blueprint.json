    "UserProfile": {
      "title": "User Profile",
      "description": "Public organizational role and scope assignment for an enterprise user.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "displayName": { "type": "string", "maxLength": 120 },
        "role": {
          "type": "string",
          "enum": [
            "SUPER_ADMIN",
            "GROUP_FINANCE_MANAGER",
            "BUSINESS_ADMIN",
            "REGIONAL_MANAGER",
            "BRANCH_ASSET_OFFICER",
            "ACCOUNTANT",
            "AUDITOR",
            "READ_ONLY_EXECUTIVE"
          ]
        },
        "assignedBusinessId": { "type": "string", "maxLength": 128 },
        "assignedRegionId": { "type": "string", "maxLength": 128 },
        "assignedBranchId": { "type": "string", "maxLength": 128 },
        "department": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "enum": ["ACTIVE", "SUSPENDED"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "role", "assignedBusinessId", "status", "createdAt", "updatedAt"]
    },
